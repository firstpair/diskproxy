#!/bin/zsh
# macOS lifecycle wrapper. All application policy lives in the server plugins.
set -eu
setopt NO_NOMATCH
umask 077
server=${DISKPROXY_SERVER:-$HOME/bin/diskproxy-server}
default_config=${DISKPROXY_CONFIG:-$HOME/.config/diskproxy/config.json}
state=${DISKPROXY_STATE_DIR:-${PMP_CARD_STATE_DIR:-$HOME/Library/Caches/diskproxy}}
# Preserve control of a session created by the former pmp-card launcher.
if [[ -z ${DISKPROXY_STATE_DIR:-} && -z ${PMP_CARD_STATE_DIR:-} && -d $HOME/Library/Caches/pmp-card/session ]]; then
  state=$HOME/Library/Caches/pmp-card
fi
# One session folder per config file, so several views can run at once:
# $state/sessions/<config name>. A session started by an older launcher in
# $state/session is still found, as the default config's session.
legacy=$state/session
session=''
session_name() {  # config file -> session name
  local name=${${1:t}%.json}
  name=${name//[^A-Za-z0-9._ -]/_}
  [[ -n $name && $name != .* ]] || name=default
  print -r -- "$name"
}
is_default_config() {
  [[ -z $1 || $1 == "$default_config" ]] || { [[ -f $1 && -f $default_config ]] && cmp -s "$1" "$default_config"; }
}
session_for() {  # config file (may be empty) -> session folder
  local dir=$state/sessions/$(session_name "${1:-$default_config}")
  if [[ ! -d $dir && -d $legacy ]] && is_default_config "$1"; then dir=$legacy; fi
  print -r -- "$dir"
}
running_sessions() {
  local -a found=()
  [[ -d $legacy ]] && found+=("$legacy")
  found+=("$state"/sessions/*(N/))
  print -rl -- "${found[@]}"
}
label_of() { [[ $1 == "$legacy" ]] && print default || print -r -- "${1:t}"; }
show_status() {
  local name=$(label_of "$session")
  if alive; then
    print -r -- "$name: proxy running (PID $(<$session/pid))."
    [[ ! -f $session/mount ]] || print -r -- "  Volume: $(<$session/mount)"
  else print -r -- "$name: not running (stale session; diskproxy --config FILE stop clears it)."; fi
}
alive() {
  [[ -f $session/pid && -f $session/birth ]] || return 1
  local pid=$(<$session/pid)
  [[ $pid == <-> ]] || return 1
  local birth=$(ps -p "$pid" -o lstart= 2>/dev/null) || return 1
  [[ $birth == "$(<$session/birth)" ]]
}
stop_session() {
  [[ -d $session ]] || { print 'No managed proxy is running.'; return; }
  if [[ -f $session/nfs-mount ]]; then
    local nmount=$(<$session/nfs-mount)
    # Plain unmount(2): umount(8) and diskutil wait minutes on rpcbind afterwards.
    if mount | grep -qF " on $nmount ("; then
      "$server" unmount "$nmount" || {
        print -u2 "Unmount of $nmount failed; close files on it and retry diskproxy stop."
        return 1
      }
    fi
    if alive; then
      local spid=$(<$session/pid) i
      kill -TERM "$spid"  # the server captures pending writes, then exits
      for i in {1..300}; do ps -p "$spid" > /dev/null 2>&1 || break; sleep 0.1; done
    fi
    rmdir -- "$nmount" 2>/dev/null || true
    rm -rf -- "$session"
    print 'Proxy stopped.'
    return
  fi
  if [[ -s $session/attach.plist && ! -f $session/device ]]; then
    print -u2 "Incomplete attachment information; inspect $session/attach.plist before stopping."
    return 1
  fi
  if [[ -f $session/harvest.pid ]]; then
    # Writable session: let the ratings harvester finish its last pass first.
    local hp=$(<$session/harvest.pid)
    if [[ $(ps -p "$hp" -o lstart= 2>/dev/null) == "$(<$session/harvest.birth)" ]]; then
      : > "$session/harvest.stop"
      local i
      for i in {1..1200}; do
        ps -p "$hp" > /dev/null 2>&1 || break
        sleep 0.1
      done
      if ps -p "$hp" > /dev/null 2>&1; then
        print -u2 "Ratings harvest still running (PID $hp); see $session/harvest.log and retry."
        return 1
      fi
    elif [[ -f $session/mount && -d $(<$session/mount) ]]; then
      # The harvester died: walk the volume once so no rating is lost.
      print -u2 'Ratings harvester was not running; checking the volume for changes...'
      local -a hargs=(${(0)"$(<$session/harvest.args)"})
      "$server" harvest "${hargs[@]}" --volume "$(<$session/mount)" \
        --since "$(<$session/mounted-at)" --once >> "$session/harvest.log" 2>&1 || {
        print -u2 "Ratings check failed; disk left mounted. See $session/harvest.log."
        return 1
      }
    fi
  fi
  if [[ -f $session/device ]]; then
    local device=$(<$session/device)
    if [[ -e $device ]]; then
      if [[ -f $session/volume-id ]]; then
        local current=$(diskutil info -plist "$device" | plutil -extract VolumeUUID raw -o - -) || return 1
        [[ $current == "$(<$session/volume-id)" ]] || {
          print -u2 'Mounted volume identity changed. Server left running.'; return 1
        }
      elif [[ -f $session/mount ]]; then
        # Compatibility with an existing session from the original PMP launcher.
        local mount=$(<$session/mount)
        local guid=$(plutil -extract guid raw -o - "$session/server.json")
        [[ -f $mount/.pmingest.dat && "$(<$mount/.pmingest.dat)" == $guid ]] || {
          print -u2 'Mounted card identity could not be verified. Server left running.'; return 1
        }
      else
        print -u2 'Cannot verify the mounted volume. Server left running.'; return 1
      fi
      hdiutil detach "$device" || {
        print -u2 'Detach failed. Server left running; finish using the disk and retry diskproxy stop.'
        return 1
      }
    fi
  fi
  if alive; then kill -TERM "$(<$session/pid)"; fi
  rm -rf -- "$session"
  print 'Proxy stopped.'
}
# --config can precede the command or follow start; remaining options go to the server.
config_args=()
explicit_config=0
while (( $# )); do
  case $1 in
    --config)
      (( $# >= 2 )) || { print -u2 '--config needs a filename'; exit 1; }
      config_args+=(--config "$2"); explicit_config=1; shift 2 ;;
    --config=*) config_args+=("$1"); explicit_config=1; shift ;;
    *) break ;;
  esac
done
selected_config() {
  local i
  for (( i = 1; i <= ${#config_args}; i++ )); do
    case $config_args[i] in
      --config) print -r -- "$config_args[i+1]"; return ;;
      --config=*) print -r -- "${config_args[i]#--config=}"; return ;;
    esac
  done
}
case ${1:-} in
  start) shift ;;
  stop|status)
    command=$1; shift
    while (( $# )); do  # also accept: diskproxy stop --config FILE
      case $1 in
        --config) (( $# >= 2 )) || { print -u2 '--config needs a filename'; exit 1; }
          config_args+=(--config "$2"); explicit_config=1; shift 2 ;;
        --config=*) config_args+=("$1"); explicit_config=1; shift ;;
        *) print -u2 "Unexpected argument: $1"; exit 1 ;;
      esac
    done
    if (( explicit_config )); then
      sessions=("$(session_for "$(selected_config)")")
      [[ -d $sessions[1] ]] || sessions=()
    else
      sessions=("${(@f)$(running_sessions)}")
      [[ -n ${sessions[1]:-} ]] || sessions=()
    fi
    if (( ${#sessions} == 0 )); then
      print 'No managed proxy is running.'; exit
    fi
    if [[ $command == status ]]; then
      for session in "${sessions[@]}"; do show_status; done
      exit
    fi
    if (( ${#sessions} > 1 )); then
      print -u2 'Several views are running:'
      for session in "${sessions[@]}"; do show_status >&2; done
      print -u2 'Choose one: diskproxy --config FILE stop'
      exit 1
    fi
    session=$sessions[1]
    stop_session; exit ;;
  -h|--help)
    print 'Usage: diskproxy [--config FILE] [start] [SOURCE] [server options]'
    print '       diskproxy [--config FILE] status | stop'
    print 'Each config file has its own view; several can run at once.'
    print 'Default config: ~/.config/diskproxy/config.json'
    print 'Plugin overrides: --set plugins.pmp.hide_ingested=true'
    exit ;;
esac
for arg in "$@"; do
  case $arg in
    --config|--config=*) explicit_config=1 ;;
    --mode|--mode=*|--check|--register)
      print -u2 "Use diskproxy-server directly for $arg; the launcher mounts disk mode."; exit 1 ;;
  esac
done
if (( ! explicit_config )) && [[ -f $default_config ]]; then
  config_args+=(--config "$default_config")
fi
[[ -x $server ]] || { print -u2 "Server binary not found: $server"; exit 1; }
config_file=$(selected_config)
args=("$@")
for (( i = 1; i <= ${#args}; i++ )); do  # a --config after start
  case $args[i] in
    --config) config_file=${args[i+1]:-} ;;
    --config=*) config_file=${args[i]#--config=} ;;
  esac
done
session=$(session_for "$config_file")
mkdir -p "$state/sessions"
if ! mkdir "$session" 2>/dev/null; then
  print -u2 "A view for $(label_of "$session") is already running. Use diskproxy status or diskproxy stop."; exit 1
fi
if (( explicit_config )); then stop_hint="diskproxy --config ${(q)config_file} stop"; else stop_hint='diskproxy stop'; fi
ready=0
cleanup() {
  if (( ! ready )); then
    print -u2 "Startup failed. Logs: $session"
    if [[ ! -s $session/attach.plist ]] && alive; then kill -TERM "$(<$session/pid)"; fi
  fi
}
trap cleanup EXIT
# The config's mode chooses the transport: nfs mounts a writable NFS view;
# anything else mounts the read-only (or shadow-writable) disk image.
mode=disk
[[ -n $config_file && $(plutil -extract mode raw -o - "$config_file" 2>/dev/null) == nfs ]] && mode=nfs
launch_server() {
  if [[ $mode == nfs ]]; then
    nohup "$server" serve "${config_args[@]}" "$@" --overlay "$session/overlay" \
      > "$session/server.json" 2> "$session/server.err" < /dev/null &
  else
    nohup "$server" serve "${config_args[@]}" "$@" --mode disk > "$session/server.json" 2> "$session/server.err" < /dev/null &
  fi
  pid=$!
  print -r -- "$pid" > "$session/pid"
  ps -p "$pid" -o lstart= > "$session/birth" || true
}
launch_server "$@"
registered=0
url=''
# Large trees take minutes to scan; wait while the server is alive (15 min cap).
attempt=0
while (( ++attempt <= 9000 )); do
  if (( attempt % 20 == 0 )); then
    # Show the server's latest scan progress line, updating in place on a terminal.
    line=$(grep '^progress: ' "$session/server.err" 2>/dev/null | tail -1)
    line=${line#progress: }
    if [[ -n $line && $line != "${last_progress:-}" ]]; then
      last_progress=$line
      if [[ -t 2 ]]; then printf '\r\e[K%s' "Scanning: $line" >&2; else print -u2 "Scanning: $line"; fi
    fi
  fi
  if [[ $mode == nfs ]]; then
    url=$(plutil -extract nfs_port raw -o - "$session/server.json" 2>/dev/null) && break
  else
    url=$(plutil -extract url raw -o - "$session/server.json" 2>/dev/null) && break
  fi
  if ! alive; then
    exit_code=0
    wait "$pid" 2>/dev/null || exit_code=$?
    if (( exit_code == 78 )); then
      registration_args=()
      remaining=("${config_args[@]}" "$@")
      while (( ${#remaining} )); do
        if [[ $remaining[1] == --config && ${#remaining} -ge 2 ]]; then
          if [[ $remaining[2] == "$default_config" ]] || cmp -s "$remaining[2]" "$default_config"; then
            remaining=("${remaining[@]:2}")
            continue
          fi
        elif [[ $remaining[1] == --config=* ]]; then
          selected_config=${remaining[1]#--config=}
          if [[ $selected_config == "$default_config" ]] || cmp -s "$selected_config" "$default_config"; then
            remaining=("${remaining[@]:1}")
            continue
          fi
        fi
        registration_args+=("$remaining[1]")
        remaining=("${remaining[@]:1}")
      done
      # A new card: register it once (current timezone; existing profiles are
      # never rewritten), then start its view.
      if (( ! registered )); then
        registered=1
        print -u2 'New card: registering it with diskproxy-server...'
        if "$server" "${config_args[@]}" "$@" > "$session/register.json" 2> "$session/register.err" < /dev/null; then
          print -u2 'Registered; starting the view.'
          launch_server "$@"
          attempt=0
          continue
        fi
        cat "$session/register.err" >&2
      fi
      ready=1
      rm -rf -- "$session"
      if (( ${#registration_args} )); then
        print -u2 "Run diskproxy-server ${(j: :)${(q)registration_args}}"
      else
        print -u2 'Run diskproxy-server.'
      fi
      exit 78
    fi
    cat "$session/server.err" >&2
    print -u2 'Options: --config FILE, --source-offset=+HH:MM; see diskproxy-server --help.'
    exit 1
  fi
  sleep 0.1
 done
[[ -n ${last_progress:-} && -t 2 ]] && print -u2
if [[ $mode == nfs ]]; then
  [[ $url == <-> ]] || { cat "$session/server.err" >&2; print -u2 'Server did not report an NFS port.'; exit 1; }
  mount=$(plutil -extract mountpoint raw -o - "$session/server.json")
  mkdir -p -- "$mount"
  [[ -z $(ls -A -- "$mount") ]] || { print -u2 "Mount point $mount is not empty."; exit 1; }
  # nolocks: the server has no lock manager; locking stays local to this Mac.
  mount_nfs -o vers=3,tcp,port=$url,mountport=$url,nolocks,soft,intr,timeo=100,retrans=5 \
    127.0.0.1:/ "$mount" || { print -u2 "mount_nfs failed for $mount"; exit 1; }
  print -r -- "$mount" > "$session/mount"
  print -r -- "$mount" > "$session/nfs-mount"
  ready=1
  disown 2>/dev/null || true
  print "Ready: $mount"
  print 'Writable NFS view: your changes go to the session overlay, never to the source.'
  print "After use: $stop_hint"
  exit 0
fi
[[ $url == http://127.0.0.1:*/card.img ]] || {
  cat "$session/server.err" >&2; print -u2 'Server did not provide a disk URL within 15 minutes.'; exit 1
}
writable=$(plutil -extract writable raw -o - "$session/server.json" 2>/dev/null || true)
attach_mode=(-readonly)
# Writable: client writes go to a shadow file in the session, never to the source.
[[ $writable == true ]] && attach_mode=(-shadow "$session/disk.shadow")
hdiutil attach "${attach_mode[@]}" -noautoopen -plist \
  -imagekey diskimage-class=CRawDiskImage "$url" > "$session/attach.plist"
mount=''
for i in {0..31}; do
  if mount=$(plutil -extract "system-entities.$i.mount-point" raw -o - "$session/attach.plist" 2>/dev/null); then
    device=$(plutil -extract "system-entities.$i.dev-entry" raw -o - "$session/attach.plist")
    print -r -- "$device" > "$session/device"
    print -r -- "$mount" > "$session/mount"
    break
  fi
 done
[[ -n $mount ]] || { print -u2 'No mounted volume in attach.plist; inspect before stopping.'; exit 1; }
diskutil info -plist "$device" | plutil -extract VolumeUUID raw -o - - > "$session/volume-id"
if [[ $writable == true ]]; then
  date +%s > "$session/mounted-at"
  print -rN -- "${config_args[@]}" "$@" > "$session/harvest.args"
  nohup "$server" harvest "${config_args[@]}" "$@" --volume "$mount" \
    --stop-file "$session/harvest.stop" > "$session/harvest.log" 2>&1 < /dev/null &
  print -r -- $! > "$session/harvest.pid"
  ps -p $! -o lstart= > "$session/harvest.birth" || true
fi
ready=1
disown 2>/dev/null || true
print "Ready: $mount"
print 'Select this volume in your application (under Disks in PMP).'
[[ $writable == true ]] && print 'Writable: changes go to a shadow file; ratings are harvested every minute.'
print "After use: $stop_hint"
