#!/bin/zsh
# Legacy interface: serving stays the default; registration is explicit.
for arg in "$@"; do
  if [[ $arg == --register ]]; then
    exec "${DISKPROXY_SERVER:-$HOME/bin/diskproxy-server}" --plugin pmp "$@"
  fi
done
exec "${DISKPROXY_SERVER:-$HOME/bin/diskproxy-server}" serve --plugin pmp "$@"
